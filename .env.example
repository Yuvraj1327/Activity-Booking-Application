# ---------------------------------------------------------------
# Root .env — used ONLY by docker-compose.yml for the local database.
# Copy to .env and fill in. Never commit .env.
#
# Application settings live next to each application:
#   backend/.env.example                 -> backend/.env
#   apps/admin_web/.env.example          -> apps/admin_web/.env.local
#   apps/mobile_app/.env.example         -> apps/mobile_app/.env   (one app: customer + owner)
# See docs/ENVIRONMENT_VARIABLES.md for every variable.
# ---------------------------------------------------------------

# Local PostgreSQL container (docker compose up db). Choose your own values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
