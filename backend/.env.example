# ZURUV backend configuration. Copy to backend/.env (git-ignored) and fill in YOUR values.
# Never commit .env. The service-role key must only ever exist on the server.

ENVIRONMENT=development          # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
# Comma-separated or JSON list. Browsers only (admin web). Defaults to localhost:3000 outside production.
CORS_ORIGINS=http://localhost:3000

# Supabase PostgreSQL (Project Settings > Database > Connection string).
# Any postgresql:// form is accepted; it is converted to the asyncpg driver.
DATABASE_URL=
# Optional: direct/session connection for Alembic migrations (recommended with the pooler).
ALEMBIC_DATABASE_URL=
# If DATABASE_URL points at the Supabase transaction pooler (port 6543), also set:
# DB_USE_NULLPOOL=true   (prepared statements are already disabled by default)

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification. Newer projects: leave SUPABASE_JWT_SECRET empty (JWKS from SUPABASE_URL is used).
# Legacy HS256 projects: set the JWT secret from Project Settings > API.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Admin endpoints require an MFA-verified session (token claim aal2). Empty = automatic:
# required in staging/production, not in development/test.
ADMIN_REQUIRE_MFA=

# Tests only (never your Supabase database!): a throwaway PostgreSQL SUPERUSER URL.
#   scripts/dev_pg.sh start     (no Docker)        or     docker compose up -d db
# TEST_DATABASE_URL=postgresql://user@127.0.0.1:54399/postgres

# ---- Booking rules (Step 6). NONE of these has an invented default: each is an open business
# decision (docs/OPEN_QUESTIONS.md). Leave empty until the rule is approved.
# hold    = a booking reserves the slot (pending_payment) until it is paid or the hold expires.
# instant = a booking is confirmed at once with payment_status "unpaid" (testing / venues with no
#           online payment). Never use "instant" to simulate payment.
BOOKING_MODE=hold
# Minutes an unpaid hold keeps the slot (N4). Empty => POST /bookings answers 503 BOOKING_NOT_CONFIGURED in hold mode.
BOOKING_HOLD_MINUTES=
# Hours before the start up to which a customer may cancel a CONFIRMED, unpaid booking (Q9).
# Empty => confirmed bookings cannot be cancelled online. Paid bookings need the refund policy (Step 7).
CANCELLATION_MIN_NOTICE_HOURS=
# Optional booking window (N6). Empty => no extra rule beyond "the slot must not have started".
BOOKING_MIN_NOTICE_MINUTES=
BOOKING_MAX_ADVANCE_DAYS=

# --- Step 7: payments (Razorpay), push (Firebase Cloud Messaging), email (Resend) -------------
# Backend only. NEVER put these in Flutter, in NEXT_PUBLIC_* variables or in git. Use TEST keys
# (rzp_test_...) outside production. Unset = the feature reports "not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard > Webhooks; a different value from the API secret.
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
# The service-account JSON text OR the path to the JSON file (keep that file out of git).
FIREBASE_SERVICE_ACCOUNT=
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. ZURUV <bookings@your-domain>
EMAIL_FROM_ADDRESS=
# In-process housekeeping loop (retry notifications/emails, reconcile payments). 0 disables.
BACKGROUND_SWEEP_SECONDS=60
PAYMENT_RECONCILE_AFTER_MINUTES=3
