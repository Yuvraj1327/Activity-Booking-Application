# ZURUV backend configuration. Copy to backend/.env (git-ignored) and fill in YOUR values.
# Never commit .env. The service-role key must only ever exist on the server.

ENVIRONMENT=development          # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
# Comma-separated or JSON list. Browsers only (admin web). Defaults to localhost:3000 outside production.
CORS_ORIGINS=http://localhost:3000

# Supabase PostgreSQL (Project Settings > Database > Connection string).
# Any postgresql:// form is accepted; it is converted to the asyncpg driver.
DATABASE_URL=
# Optional: direct/session connection for Alembic migrations (recommended with the pooler).
ALEMBIC_DATABASE_URL=
# If DATABASE_URL points at the Supabase transaction pooler (port 6543), also set:
# DB_USE_NULLPOOL=true   (prepared statements are already disabled by default)

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification. Newer projects: leave SUPABASE_JWT_SECRET empty (JWKS from SUPABASE_URL is used).
# Legacy HS256 projects: set the JWT secret from Project Settings > API.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Admin endpoints require an MFA-verified session (token claim aal2). Empty = automatic:
# required in staging/production, not in development/test.
ADMIN_REQUIRE_MFA=

# Tests only (never your Supabase database!): a throwaway PostgreSQL SUPERUSER URL.
#   scripts/dev_pg.sh start     (no Docker)        or     docker compose up -d db
# TEST_DATABASE_URL=postgresql://user@127.0.0.1:54399/postgres
