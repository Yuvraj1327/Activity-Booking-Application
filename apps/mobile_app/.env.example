SUPABASE_URL=
SUPABASE_ANON_KEY=
API_BASE_URL=http://localhost:8008/api/v1
AUTH_REDIRECT_URL=io.zuruv.app://login-callback
GOOGLE_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false
PHONE_AUTH_ENABLED=false

# Google Maps / Places (public, restricted keys; see docs/GOOGLE_MAPS_SETUP.md).
# Native SDKs read the two MAPS keys via ./tool/sync_native_keys.sh.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
# Web build: Maps JavaScript API key, restrict by HTTP referrer (your web domains + localhost).
GOOGLE_MAPS_API_KEY_WEB=
GOOGLE_PLACES_API_KEY=

# Google Sign-In (public OAuth client IDs, see docs/GOOGLE_SIGN_IN_SETUP.md). Create them in Google Cloud Console.
# WEB client id = the one pasted into Supabase > Auth > Providers > Google. Leave empty to use the browser flow.
GOOGLE_WEB_CLIENT_ID=
# iOS client id (bundle id com.zuruv.zuruv). Android uses the Android client (package + SHA-1), no id needed in the app.
GOOGLE_IOS_CLIENT_ID=
