# ZURUV admin web. Copy to .env.local (git-ignored). Everything here is PUBLIC (shipped to the
# browser): never put the Supabase service-role key or any secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8008/api/v1
